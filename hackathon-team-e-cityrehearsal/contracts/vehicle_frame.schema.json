{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C1 Vehicle frame (sim -> frontend), one per simulation second",
  "type": "object",
  "required": ["t", "vehicles"],
  "properties": {
    "t": {"type": "number", "description": "simulation time in seconds"},
    "vehicles": {"type": "array", "items": {"type": "object",
      "required": ["id", "type", "lon", "lat", "z", "angle", "speed"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["two_wheeler", "car", "auto", "bus", "truck"]},
        "lon": {"type": "number"}, "lat": {"type": "number"},
        "z": {"type": "number", "description": "height in metres; > 0 on a flyover"},
        "angle": {"type": "number", "description": "heading in degrees, 0 = north"},
        "speed": {"type": "number", "description": "m/s"}}}}
  }
}
