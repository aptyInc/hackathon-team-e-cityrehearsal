[Unit]
Description=Terascope AI API (FastAPI, real SUMO corridor runs, MOCK_SIM=0)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/terascope/backend
EnvironmentFile=/etc/terascope/env
ExecStart=/opt/terascope/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
